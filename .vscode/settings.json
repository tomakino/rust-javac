{
  "java.server.launchMode": "Standard",
  "java.completion.enabled": false,
  "java.signatureHelp.enabled": false,
  "java.inlayHints.parameterNames.enabled": "none",
  "java.inlayHints.variableTypes.enabled": false,
  "java.inlayHints.parameterTypes.enabled": false,
  "editor.suggest.showWords": false,
  "editor.wordBasedSuggestions": "off",
  "editor.suggest.showSnippets": false,
  "editor.suggest.filterGraceful": false,
  "ravacLsp.serverPath": "${workspaceFolder}/target/debug/ravac-lsp.exe",
  "ravacLsp.classPath": "${workspaceFolder}/target/tmp/perf/javac",
  "ravacLsp.sourceLevel": "17",
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable"
}
